# Copy to .env (or use .env.dev) and adjust values for your environment.
NODE_ENV=development
DEBUG=true

# Frontend / Maintenance app -> PostgREST API
API_URL=http://localhost:5000

# Postgres connection (used by PostgREST)
DATABASE_URL=postgres://app_user:password@db:5432/app_db
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=password

# Redis
REDIS_URL=redis://redis:6379

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

LOG_LEVEL=debug
